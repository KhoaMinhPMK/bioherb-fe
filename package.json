      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prop-types": "^15.8.1",
    "sass": "^1.98.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
